{
    "build-debug": {
        "working_dir": "./build/Debug",
        "scripts": [
            "cmake ../.. -B . -DBUILD_TEST_CODE=ON -DCMAKE_BUILD_TYPE=Debug",
            "cmake --build . --target TEST_CODE --parallel $(($(nproc)-1))"
        ]
    },
    "build-release": {
        "working_dir": "./build/Release",
        "scripts": [
            "cmake ../.. -B . -DBUILD_TEST_CODE=ON -DCMAKE_BUILD_TYPE=Release",
            "cmake --build . --target TEST_CODE --parallel $(($(nproc)-1))"
        ]
    },
    "run-debug": {
        "scripts": [
            "./build/Debug/TEST_CODE"
        ]
    },
    "run-release": {
        "scripts": [
            "./build/Release/TEST_CODE"
        ]
    },
    "build-debug-and-run": {
        "scripts": [
            "@@ test-code build-debug",
            "@@ test-code run-debug"
        ]
    },
    "build-release-and-run": {
        "scripts": [
            "@@ test-code build-release",
            "@@ test-code run-release"
        ]
    }
}
